<div class="dropdown d-inline-block" {{ stimulusController('twig/table/column', {'queryName':queryName}) }}>
    <button type="button"
            class="btn btn-link text-decoration-none btn-sm dropdown-toggle show dropdown-sm"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            style="border: 1px solid;color: var(--bs-body-color);border: var(--bs-border-width) solid var(--bs-border-color);"
    >
        {{ label }}
    </button>
    <ul class="dropdown-menu" data-bs-theme="light">
        {% for option in columns %}
            {% if option.value != '' %}
                <li>
                    <a class="dropdown-item" {{ stimulusTarget('twig/table/column', 'option') }}
                       data-value="{{ loop.index - 1 }}"
                       href=""
                    >
                        {% set icon = ((loop.index - 1) in this.columns()) ? 'bi:eye-slash' : 'bi:eye' %}
                        {{ ux_icon(icon, {class:'bi'}) }}
                        {{ option.getLabelFrom(option) }}
                    </a>
                </li>
            {% endif %}
        {% endfor %}
    </ul>
</div>
