{% extends 'pdf.html.twig' %}

{% block title %}Estado técnico{% endblock %}

{% block header %}
    <div style=";width: 49%" class="col">
        <img src="{{ logo }}" class="logo" alt="Logo" style="max-height: 60px;">
        <h2 style="">Estado técnico</h2>
    </div>

    <div style="width: 49%;" class="col">
        <div style="margin-left: 0px">
            <h3>Proyecto:</h3>
            <strong>Proyecto:</strong> {{ sub_system.floor.building.project.name }}<br>
            <strong>Obra:</strong> {{ sub_system.floor.building.name }}<br>
            <strong>Planta:</strong> {{ sub_system.floor.name }}<br>
            <strong>Subsistema:</strong> {{ sub_system.name }}<br>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div>
        <strong>Resumen de estado técnico de los locales de este subsistema.</strong>
    </div>
    <br>
    <table>
        <tr>
            <th>Estado técnico</th>
            <th>Cantidad</th>
            <th>Metros(m<sup>2</sup>)</th>
        </tr>
        <tr>
            <td>Bueno</td>
            <td>{{ local_status.good }}</td>
            <td>{{ meter_status.good|number_format(2) }}</td>
        </tr>
        <tr>
            <td>Regular</td>
            <td>{{ local_status.regular }}</td>
            <td>{{ meter_status.regular|number_format(2) }}</td>
        </tr>
        <tr>
            <td>Malo</td>
            <td>{{ local_status.bad }}</td>
            <td>{{ meter_status.bad|number_format(2) }}</td>
        </tr>
        <tr>
            <td>Crítico</td>
            <td>{{ local_status.critical }}</td>
            <td>{{ meter_status.critical|number_format(2) }}</td>
        </tr>
        <tr>
            <td>Sin definir</td>
            <td>{{ local_status.undefined }}</td>
            <td>{{ meter_status.undefined|number_format(2) }}</td>
        </tr>
        <tr>
            <th>Totales</th>
            <th>{{ sub_system.getLocalsAmount() }}</th>
            <th>{{ sub_system.getAmountMeters()|number_format(2) }}</th>
        </tr>
    </table>
{% endblock %}

{% block footer %}
    Procrea S.R.L.<br>
    {{ 'now'|date('Y-m-d') }}
{% endblock %}
