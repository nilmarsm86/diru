{% extends 'location_zone/pdf/pdf.html.twig' %}

{% block columns %}
    <tr>
        {{ th(0, 'column', 'Nombre') }}
        {{ th(1, 'column', 'Proyectos') }}
        {{ th(2, 'column', 'Obras') }}
    </tr>
{% endblock %}

{% block data %}
    <tr>
        {{ td(0, 'column', organization.name) }}
        {{ td(1, 'column', organization.projects) }}
        {{ td(2, 'column', organization.buildings) }}
    </tr>
{% endblock %}
