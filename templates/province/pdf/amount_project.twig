{% extends 'province/pdf/pdf_province.html.twig' %}

{% block columns %}
    <tr>
        {{ th(0, 'column', 'Provincia') }}
        {{ th(1, 'column', 'Proyectos') }}
        {{ th(2, 'column', 'Obras') }}
    </tr>
{% endblock %}

{% block data %}
    <tr>
        {{ td(app.request, 0, 'column', province.name) }}
        {{ td(app.request, 1, 'column', province.projects) }}
        {{ td(app.request, 2, 'column', province.buildings) }}
    </tr>
{% endblock %}
