{% extends 'province/pdf/pdf_province.html.twig' %}

{% block columns %}
    <tr>
        {{ th(app.request, 1, 'column', 'Provincia') }}
        {{ th(app.request, 2, 'column', 'Empresarial') }}
        {{ th(app.request, 3, 'column', 'Natural') }}
    </tr>
{% endblock %}

{% block data %}
    <tr>
        {{ td(app.request, 1, 'column', province.name) }}
        {{ td(app.request, 2, 'column', province.enterprise) }}
        {{ td(app.request, 3, 'column', province.individual) }}
    </tr>
{% endblock %}
