{% extends 'corporate_entity/pdf/pdf.html.twig' %}

{% block columns %}
    <tr>
        {{ th(0, 'column', 'Nombre') }}
        {{ th(1, 'column', 'V. Aprobado ('~currency~')') }}
        {{ th(2, 'column', 'V. Estimado ('~currency~')') }}
        {{ th(3, 'column', 'P. Estimado ('~currency~')') }}
        {{ th(4, 'column', 'P. Detallado ('~currency~')') }}
        {{ th(5, 'column', 'V. Real ('~currency~')') }}
    </tr>
{% endblock %}

{% block data %}
    <tr>
        {{ td(0, 'column', corporate_entity.name) }}
        {{ td(1, 'column', money(corporate_entity.approvedValue)) }}
        {{ td(2, 'column', money(corporate_entity.estimatedValue)) }}
        {{ td(3, 'column', money(corporate_entity.estimatedAdjustValue)) }}
        {{ td(4, 'column', money(corporate_entity.constructionAssembly)) }}
        {{ td(5, 'column', money(corporate_entity.constructionRealValue)) }}
    </tr>
{% endblock %}
