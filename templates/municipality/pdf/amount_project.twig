{% extends 'municipality/pdf/pdf_municipality.html.twig' %}

{% block columns %}
    <tr>
        <th>Nombre</th>
        <th>Provincia</th>
        <th>Proyectos</th>
        <th>Obras</th>
    </tr>
{% endblock %}

{% block data %}
    <tr>
        <td>{{ municipality.name }}</td>
        <td>{{ municipality.province }}</td>
        <td>{{ municipality.projects }}</td>
        <td>{{ municipality.buildings }}</td>
    </tr>
{% endblock %}
