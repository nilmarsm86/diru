{% if not app.request.query.get('modal') %}
{% component 'Card:Card' with {
    cssClass: 'mb-4',
    extra: '',
    headerCssClass: 'd-flex justify-content-between align-items-center',
    title: 'Listado de ITE '~ type.getLabelFrom(type),
} %}
    {% block header %}
        {% from 'macros/buttons.html.twig' import tableActionButton3 %}

        <div>
            {{ component('Card:Refresh', {
                path: path(path),
                queryNames:['quality', 'amount', 'filter', 'page', 'mu', 'source', 'pt', 'city', 'country']
            }) }}

            {{ component('Card:FilterDropDown', {
                path:path,
                label:'Calidad',
                queryName: 'quality',
                options:qualities
            }) }}

            {{ component('Card:FilterDropDown', {
                path:path,
                label:'Unidad de medida',
                queryName: 'mu',
                options:measurementUnits
            }) }}

            {{ component('Card:FilterDropDown', {
                path:path,
                label:'Fuente',
                queryName: 'source',
                options:sources
            }) }}

            {{ component('Card:FilterDropDown', {
                path:path,
                label:'Tipo de proyecto',
                queryName: 'pt',
                options:projectTypes
            }) }}

            {% if path is same as 'app_ite_international' %}
                {{ component('Card:FilterDropDown', {
                    path:path,
                    label:'Ciudades',
                    queryName: 'city',
                    options:cities
                }) }}

                {{ component('Card:FilterDropDown', {
                    path:path,
                    label:'Paises',
                    queryName: 'country',
                    options:countries
                }) }}
            {% endif %}

            {{ tableActionButton3(path('app_ite_new', {'type':type.value}), 'bi:plus-lg', 'Nuevo', 'Nuevo ITE', stimulusAction('twig/card/card', 'newElement:prevent', null, {url:path('app_ite_new', {'type':type.value})})) }}
            {{ tableActionButton3(path('ite_export', {type: ( path is same as 'app_ite_international') ? 'international' : 'national'}), 'bi:file-earmark-excel', '', 'Exportar a excel', '', 'btn-info') }}
        </div>
    {% endblock %}

    {% block body %}
        {{ include('ite/_table.html.twig') }}
    {% endblock %}

{% endcomponent %}
{% else %}
    {{ include('ite/_table.html.twig') }}
{% endif %}
