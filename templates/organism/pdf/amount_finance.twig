{% extends 'organism/pdf/pdf.html.twig' %}

{% block columns %}
    <tr>
        {{ th(0, 'column', 'Nombre') }}
        {{ th(1, 'column', 'V. Aprobado ('~currency~')') }}
        {{ th(2, 'column', 'V. Estimado ('~currency~')') }}
        {{ th(3, 'column', 'P. Estimado ('~currency~')') }}
        {{ th(4, 'column', 'P. Detallado ('~currency~')') }}
        {{ th(5, 'column', 'V. Real ('~currency~')') }}
    </tr>
{% endblock %}

{% block data %}
    <tr>
        {{ td(0, 'column', organism.name) }}
        {{ td(1, 'column', money(organism.approvedValue)) }}
        {{ td(2, 'column', money(organism.estimatedValue)) }}
        {{ td(3, 'column', money(organism.estimatedAdjustValue)) }}
        {{ td(4, 'column', money(organism.constructionAssembly)) }}
        {{ td(5, 'column', money(organism.constructionRealValue)) }}
    </tr>
{% endblock %}
