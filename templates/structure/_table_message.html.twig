{% if isNew %}Área de terreno{% else %}Área ocupada{% endif %} de la obra: {{ maxArea|number_format(2) }}m<sup>2</sup>

{% if isFullyOccupied %}
    {% if hasFreeArea %}
        {% if isBlocked %}
            , ocupados, <br>con un área libre total de {{ freeArea|number_format(2) }}m<sup>2</sup>.
        {% else %}
            , ocupados totalmente, <br>con un área libre total de {{ freeArea|number_format(2) }}m<sup>2</sup>.
        {% endif %}
    {% else %}
        , ocupados totalmente.
        {% if hasUnassignedArea %}
            <br>con espacio extra de {{ unassignedArea|number_format(2) }}m<sup>2</sup>.
        {% else %}
            <br>con espacio extra de {{ (landArea - maxArea)|number_format(2) }}m<sup>2</sup>.
        {% endif %}
    {% endif %}
    {% if reply %}<br>De un área de terreno: {{ landArea|number_format(2) }}m<sup>2</sup><br>{% endif %}
{% else %}
    , quedan {{ unassignedArea|number_format(2) }}m<sup>2</sup> en total
    {% if isNew %}de área sin asignar.{% else %}por asignar en el área ocupada.{% endif %}
{% endif %}
