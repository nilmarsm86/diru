{% extends 'corporate_entity/pdf/pdf.html.twig' %}

{% block columns %}
    <tr>
        {{ th(0, 'column', 'Nombre') }}
        {{ th(1, 'column', 'Clientes') }}
        {{ th(2, 'column', 'Constructora') }}
        {{ th(3, 'column', 'Cliente y Constructora') }}
        {{ th(4, 'column', 'Proyectista') }}
        {{ th(5, 'column', 'Total') }}
    </tr>
{% endblock %}

{% block data %}
    <tr>
        {{ td(0, 'column', corporate_entity.name) }}
        {{ td(1, 'column', corporate_entity.client) }}
        {{ td(2, 'column', corporate_entity.constructor) }}
        {{ td(3, 'column', corporate_entity.client_constructor) }}
        {{ td(4, 'column', corporate_entity.draftman) }}
        {{ td(5, 'column', corporate_entity.total) }}
    </tr>
{% endblock %}
