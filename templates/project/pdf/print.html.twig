{% extends 'pdf_nomenclator.html.twig' %}

{% block content %}
    {% from 'macros/pdf.html.twig' import two_columns %}

    {{ two_columns('Nombre', project.name) }}
    {{ two_columns('Datos de la inversión', project.investment.getAddress()) }}
    {{ two_columns('Tipo de cliente', client_type) }}
    {{ two_columns('Detalle cliente', include('project/pdf/_enterprise_client.html.twig', {widthName: 26, widthValue: 62})) }}
    {{ two_columns('Moneda', project.currency) }}
    {{ two_columns('Planificador', project.getActivePlanner()?.getFullName()) }}
    {{ two_columns('Contrato', include('project/pdf/_contract.html.twig', {widthName: 25, widthValue: 63})) }}
    {{ two_columns('Estado', project.state.getLabelFrom(project.state)) }}
    {{ two_columns('Detenido', project.stopReason) }}
    {{ two_columns('Comentario', project.comment) }}
    {{ two_columns('Monto', money(project.getPrice(), project.currency.code)) }}

    <div>
        <div style=";width: 100%;vertical-align: top" class="col">
            <strong>Obras:</strong>
        </div>
    </div>
    <br>
    <div>
        <div style=";width: 100%;vertical-align: top" class="col">
            {{ include('building/pdf/_list.html.twig', {'buildings':project.buildings}) }}
        </div>
    </div>

{% endblock %}
