{% extends 'municipality/pdf/pdf_municipality.html.twig' %}

{% block columns %}
    <tr>
        <th>Nombre</th>
        <th>Provincia</th>
        <th>Empresarial</th>
        <th>Natural</th>
    </tr>
{% endblock %}

{% block data %}
    <tr>
        <td>{{ municipality.name }}</td>
        <td>{{ municipality.province }}</td>
        <td>{{ municipality.enterprise }}</td>
        <td>{{ municipality.individual }}</td>
    </tr>
{% endblock %}
