{% extends 'content.html.twig' %}

{% from 'macros/breadcrumb.html.twig' import breadcrumb %}
{% from 'macros/tab.html.twig' import tab %}
{% from 'macros/titles.html.twig' import h1 %}

{% block title %}Editar Proyecto{% endblock %}

{% block content %}
    <div class="row">
        {{ h1('Proyectos', 'bi:table') }}

        {{ breadcrumb([
            {label: 'Inicio', href: path('app_home')},
            {label: 'Proyectos', href: path('app_project_index')},
            {label: 'Editar'},
        ]) }}
    </div>

    <h2 class="mb-4">Editar Proyecto</h2>

    {{ tab([
        {label: 'Dashboard', href: 'app_project_dashboard'},
        {label: 'Formulario', href: 'app_project_edit'},
    ], project) }}

    {{ include('project/'~tab~'.html.twig', {'showButton': true, 'title': title}) }}
{% endblock %}
