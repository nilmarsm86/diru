{% extends 'content.html.twig' %}

{% from 'macros/breadcrumb.html.twig' import breadcrumb %}
{% from 'macros/tab.html.twig' import tab %}
{% from 'macros/titles.html.twig' import h1 %}

{% block title %}Editar Obra{% endblock %}

{% block content %}
    <div class="row">
        {{ h1('Obras', 'streamline-pixel:construction-building-real-eastate') }}

        {{ breadcrumb([
            {label: 'Inicio', href: path('app_home')},
            {label: 'Obras', href: path('app_building_project', {'project':project.id})},
            {label: 'Editar'},
        ]) }}
    </div>

    <h2 class="mb-4">Editar: {{ building.name }} del proyecto {{ building.project.name }}</h2>

    {{ tab([
        {label: 'Dashboard', href: null, path: path('app_building_dashboard', {'id': building.id, 'project':project.id})},
        {label: 'Formulario', href: null, path: path('app_building_edit', {'id': building.id, 'project':project.id})},
    ], building) }}

    {{ include('building/'~tab~'.html.twig', {'showButton': true, 'title': title}) }}
{% endblock %}
