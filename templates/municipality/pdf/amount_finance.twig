{% extends 'municipality/pdf/pdf_municipality.html.twig' %}

{% block columns %}
    <tr>
        {{ th(0, 'column', 'Nombre') }}
        {{ th(1, 'column', 'Provincia') }}
        {{ th(2, 'column', 'V. Aprobado ('~currency~')') }}
        {{ th(3, 'column', 'V. Estimado ('~currency~')') }}
        {{ th(4, 'column', 'P. Estimado ('~currency~')') }}
        {{ th(5, 'column', 'P. Detallado ('~currency~')') }}
        {{ th(6, 'column', 'V. Real ('~currency~')') }}
    </tr>
{% endblock %}

{% block data %}
    <tr>
        {{ td(0, 'column', municipality.name) }}
        {{ td(1, 'column', municipality.province) }}
        {{ td(2, 'column', money(municipality.approvedValue)) }}
        {{ td(3, 'column', money(municipality.estimatedValue)) }}
        {{ td(4, 'column', money(municipality.estimatedAdjustValue)) }}
        {{ td(5, 'column', money(municipality.constructionAssembly)) }}
        {{ td(6, 'column', money(municipality.constructionRealValue)) }}
    </tr>
{% endblock %}
