{% extends 'content.html.twig' %}

{% from 'macros/breadcrumb.html.twig' import breadcrumb %}

{% block title %}Diru{% endblock %}

{% block content %}
    <div
        style="background-image: url({{ asset('images/dashboard1.jpg') }});min-height: 500px;padding: 10px;background-size: cover">

        <div class="row">
            <div class="col-4">
                {% component 'Card:Card' with {
                    title: 'Monto Total',
                    icon: ux_icon('streamline-cyber-color:money-bag-1', {class:'bi'})
                } %}
                    {% block body %}
                        <h1>$ {{ money(amount) }}</h1>
                    {% endblock %}
                {% endcomponent %}
            </div>

            <div class="col-4">
                {% component 'Card:Card' with {
                    title: 'Compuesto por',
                } %}
                    {% block body %}
                        <h3>{{ project_amount }} Proyectos</h3>
                        <h5>{{ urban_regulations }} Regulaciones Urbanas <br>{{ subsystems }} Subsistemas en 3 Obras
                        </h5>
                    {% endblock %}
                {% endcomponent %}
            </div>

            <div class="col-4">
                {% component 'Card:Card' with {
                    cssClass: 'text-bg-light mb-3',
                    title: 'Rango de Ite Obras ajuste',
                    icon: ux_icon('material-symbols:arrow-range', {class:'bi'})
                } %}
                    {% block body %}
                        <div class="row">
                            <div class="col-12 text-center">
                                <div class="mb-0">
                                    <input type="range" min="{{ min * 10 }}"
                                           max="{{ max * 10 }}" class="form-range" value="14" readonly>
                                </div>
                                <div class="row">
                                    <div class="col text-start">
                                        <output><strong>{{ min|number_format(2) }} $/m<sup>2</sup></strong></output>
                                    </div>
                                    <div class="col text-center">
                                        <output aria-hidden="true" class="badge text-bg-info" style="font-size: 1em">
                                            {{ ((min + max) / 2)|number_format(2) }}
                                        </output>
                                    </div>
                                    <div class="col text-end">
                                        <output><strong>{{ max|number_format(2) }} $/m<sup>2</sup></strong></output>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endblock %}
                {% endcomponent %}
            </div>
        </div>
        <br>
        <div class="row">
            <div class="col-4">
                <div class="row">
                    <div class="col-12">
                        {% component 'Card:Card' with {
                            cssClass: 'text-bg-light mb-3',
                            title: '% Aprobado'
                        } %}
                            {% block body %}
                                <div class="row">
                                    <div class="col">
                                        <div class="progress" role="progressbar" aria-label="Info example"
                                             aria-valuenow="{{ finance['approvedValue'] }}" aria-valuemin="0"
                                             aria-valuemax="{{ finance['estimatedValue'] }}" style="height: 20px">
                                            <div class="progress-bar text-bg-info"
                                                 style="width: {{ (finance['approvedValue'] * 100 / finance['estimatedValue'])|number_format(2) }}%">
                                                <strong>{{ (finance['approvedValue'] * 100 / finance['estimatedValue'])|number_format(2) }}
                                                    %</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col text-start">
                                        <strong>Meta:</strong> ${{ money(finance['estimatedValue']) }}
                                    </div>
                                    <div class="col text-end">
                                        <strong>Logro:</strong> ${{ money(finance['approvedValue']) }}
                                    </div>
                                </div>
                            {% endblock %}
                        {% endcomponent %}
                    </div>
                    <div class="col-12">
                        {% component 'Card:Card' with {
                            title: 'Clientes en el sistema',
                        } %}
                            {% block body %}
                                {{ render_chart(chart5) }}
                            {% endblock %}
                        {% endcomponent %}
                    </div>
                </div>
            </div>

            <div class="col-4">
                {% component 'Card:Card' with {
                    cssClass: 'text-bg-light mb-3',
                    title: 'Distribución por últimos proyectos'
                } %}
                    {% block body %}
                        {{ render_chart(chart2) }}
                    {% endblock %}
                {% endcomponent %}
            </div>

            <div class="col-4">
                {% component 'Card:Card' with {
                    cssClass: 'text-bg-light mb-3',
                    title: 'Proyectos por estado'
                } %}
                    {% block body %}
                        {{ render_chart(chart4) }}
                    {% endblock %}
                {% endcomponent %}
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                {% component 'Card:Card' with {
                    title: 'Total de finanzas de obras',
                    cssClass: 'text-bg-light mb-3',
                } %}
                    {% block body %}
                        <div class="row">
                            <div class="col" style="height: 300px;">{{ render_chart(chart3) }}</div>
                        </div>
                    {% endblock %}
                {% endcomponent %}
            </div>
        </div>
    </div>
{% endblock %}
