{% component 'Card:Card' with {
    cssClass: 'mb-4',
    extra: '',
    headerCssClass: 'd-flex justify-content-between align-items-center',
    title: 'Listado de municipios',
} %}
    {% block header %}
        {% from 'macros/buttons.html.twig' import tableActionButton3 %}

        <div>
            <div class="dropdown d-inline-block">
                <button type="button"
                        class="btn text-decoration-none btn-sm dropdown-toggle show dropdown-sm btn-info"
                        data-bs-toggle="dropdown"
                        aria-expanded="false" title="Obras del proyecto"
                >
                    Reportes
                </button>
                <ul class="dropdown-menu" data-bs-theme="light">
                    <li>
                        <a class="dropdown-item"
                           href="{{ path('app_municipality_amount_project_report') }}" title="">
                            Cantidad de proyectos y obras
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item"
                           href="" title="">
                            Financiero
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item"
                           href="{{ path('app_municipality_amount_client_report') }}" title="">
                            Tipos de clientes
                        </a>
                    </li>
                </ul>
            </div>

            {{ tableActionButton3(path('app_municipality_new'), 'bi:plus-lg', 'Nuevo', 'Nuevo municipio', stimulusAction('twig/card/card', 'newElement:prevent', null, {url:path('app_municipality_new')})) }}
            {{ tableActionButton3(path('app_municipality_print', app.request.query.all), 'bi:printer', '', 'Imprimir', 'target="_blank"', 'btn-info') }}
        </div>
    {% endblock %}

    {% block body %}
        {% component 'Table:Table' with {
            paginator: paginator,
        } %}

            {% block tableHead %}
                <tr>
                    <th>Nombre</th>
                    <th>Provincia {{ ux_icon('mdi:filter', {class:'bi'}) }}</th>
                    <th></th>
                </tr>
            {% endblock %}

            {% block tableBody %}
                {% from 'macros/buttons.html.twig' import tableActionButton3 %}
                {% from 'macros/link.html.twig' import filterLink %}

                {% for municipality in paginator.getData() %}
                    <tr {{ stimulusController('delete-form-container') }}>
                        <td>{{ municipality.name }}</td>
                        <td>
                            <a href="{{ filterLink(municipality.province) }}"
                               class="text-decoration-none"
                            >
                                {{ municipality.province }}
                            </a>
                        </td>
                        <td class="text-end">
{#                            {{ tableActionButton3(path('app_municipality_show', {'id': municipality.id}), 'bi:eye', '', 'Detalle del municipio', stimulusAction('twig/table/table', 'selectElement:prevent', null, {url:path('app_municipality_show', {'id': municipality.id})})) }}#}
                            {{ tableActionButton3(path('app_municipality_edit', {'id': municipality.id}), 'fa:edit', '', 'Editar municipio', stimulusAction('twig/table/table', 'selectElement:prevent', null, {url:path('app_municipality_edit', {'id': municipality.id})}), 'btn-link') }}

                            {{ component('DeleteForm', {
                                path: path('app_municipality_delete', {'id': municipality.id}),
                                confirm: 'Está seguro que desea eliminar el municipio?',
                                token: 'delete' ~ municipality.id,
                                title: 'Eliminar municipio',
                                icon: 'bi:trash',
                                cssClass: 'btn-link text-danger'
                            }) }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">No se encontraron municipios.</td>
                    </tr>
                {% endfor %}
            {% endblock %}

        {% endcomponent %}

    {% endblock %}

{% endcomponent %}
