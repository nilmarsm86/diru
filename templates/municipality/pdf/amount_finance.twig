{% extends 'municipality/pdf/pdf_municipality.html.twig' %}

{% block columns %}
    <tr>
        {{ th(app.request, 0, 'column', 'Nombre') }}
        {{ th(app.request, 1, 'column', 'Provincia') }}
        {{ th(app.request, 2, 'column', 'V. Aprobado ('~currency~')') }}
        {{ th(app.request, 3, 'column', 'V. Estimado ('~currency~')') }}
        {{ th(app.request, 4, 'column', 'P. Estimado ('~currency~')') }}
        {{ th(app.request, 5, 'column', 'P. Detallado ('~currency~')') }}
        {{ th(app.request, 6, 'column', 'V. Real ('~currency~')') }}
    </tr>
{% endblock %}

{% block data %}
    <tr>
        {{ td(app.request, 0, 'column', municipality.name) }}
        {{ td(app.request, 1, 'column', municipality.province) }}
        {{ td(app.request, 2, 'column', municipality.approvedValue) }}
        {{ td(app.request, 3, 'column', municipality.estimatedValue) }}
        {{ td(app.request, 4, 'column', municipality.estimatedAdjustValue) }}
        {{ td(app.request, 5, 'column', municipality.constructionAssembly) }}
        {{ td(app.request, 6, 'column', municipality.constructionRealValue) }}
    </tr>
{% endblock %}
