{% extends 'province/pdf/pdf_province.html.twig' %}

{% block columns %}
    <tr>
        {{ th(1, 'column', 'Provincia') }}
        {{ th(2, 'column', 'Empresarial') }}
        {{ th(3, 'column', 'Natural') }}
    </tr>
{% endblock %}

{% block data %}
    <tr>
        {{ td(1, 'column', province.name) }}
        {{ td(2, 'column', province.enterprise) }}
        {{ td(3, 'column', province.individual) }}
    </tr>
{% endblock %}
