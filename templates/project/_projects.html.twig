<tr>
    <th>Proyectos:</th>
    <td>
        <ul class="px-0 list-unstyled">
            {% for project in entity.projects %}
                <li>
                    <a href="#"
                        {{ stimulusController('modal-content-loader', {
                            url: path('app_project_show', {'id':project.id, 'modal':'modal-load', 'state':'modal'}),
                            id: 'modal-load',
                            placeholder: 'Cargando...',
                            title: 'Proyecto',
                        }) }} {{ stimulusTarget('modal-content-loader', 'button') }}
                    >
                        {{ project.name }} {{- ux_icon('bx:link-external', {class:'bi'}) -}}
                    </a>
                    -
                    <a href="#"
                        {{ stimulusController('modal-content-loader', {
                            url: path('app_investment_show', {'id':project.investment.id, 'modal':'modal-load', 'state':'modal'}),
                            id: 'modal-load',
                            placeholder: 'Cargando...',
                            title: 'Inversión',
                        }) }} {{ stimulusTarget('modal-content-loader', 'button') }}
                    >
                        {{ project.investment.name }} {{- ux_icon('bx:link-external', {class:'bi'}) -}}
                    </a>
                </li>
            {% else %}
                <li class="text-danger">No tiene proyectos asociadas.</li>
            {% endfor %}
        </ul>
    </td>
</tr>
