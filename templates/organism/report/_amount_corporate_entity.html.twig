{% component 'Card:Card' with {
    cssClass: 'mb-4',
    extra: '',
    headerCssClass: 'd-flex justify-content-between align-items-center',
    title: title,
} %}
    {% block header %}
        {{ include('organism/_header.html.twig', {'print_link':'app_organism_amount_corporate_entity_report_print'}) }}
    {% endblock %}

    {% block body %}
        {% component 'Table:Table' with {
            paginator: paginator,
            columns: [null, 'Cliente', 'Constructor', 'Cliente y Constructor', 'Proyectista', 'Total']
        } %}

            {% block tableHead %}
                <tr>
                    <th>Nombre</th>
                    <th>Cliente</th>
                    <th>Constructor</th>
                    <th>Cliente y Constructor</th>
                    <th>Proyectista</th>
                    <th>Total</th>
                </tr>
            {% endblock %}

            {% block tableBody %}
                {% from 'macros/link.html.twig' import filterLink %}

                {% for organism in paginator.getData() %}
                    <tr>
                        <td>{{ organism.name }}</td>
                        <td>{{ organism.client }}</td>
                        <td>{{ organism.constructor }}</td>
                        <td>{{ organism.client_constructor }}</td>
                        <td>{{ organism.draftman }}</td>
                        <td>{{ organism.total }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">No se encontraron organismos.</td>
                    </tr>
                {% endfor %}
            {% endblock %}

        {% endcomponent %}

    {% endblock %}

{% endcomponent %}
