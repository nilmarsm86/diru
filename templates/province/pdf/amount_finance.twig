{% extends 'municipality/pdf/pdf_municipality.html.twig' %}

{% block columns %}
    <tr>
        {{ th(0, 'column', 'Nombre') }}
        {{ th(1, 'column', 'V. Aprobado ('~currency~')') }}
        {{ th(2, 'column', 'V. Estimado ('~currency~')') }}
        {{ th(3, 'column', 'P. Estimado ('~currency~')') }}
        {{ th(4, 'column', 'P. Detallado ('~currency~')') }}
        {{ th(5, 'column', 'V. Real ('~currency~')') }}
    </tr>
{% endblock %}

{% block data %}
    <tr>
        {{ td(0, 'column', municipality.name) }}
        {{ td(1, 'column', municipality.approvedValue) }}
        {{ td(2, 'column', municipality.estimatedValue) }}
        {{ td(3, 'column', municipality.estimatedAdjustValue) }}
        {{ td(4, 'column', municipality.constructionAssembly) }}
        {{ td(5, 'column', municipality.constructionRealValue) }}
    </tr>
{% endblock %}
