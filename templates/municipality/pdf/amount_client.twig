{% extends 'municipality/pdf/pdf_municipality.html.twig' %}

{% block columns %}
    <tr>
        {{ th(0, 'column', 'Nombre') }}
        {{ th(1, 'column', 'Provincia') }}
        {{ th(2, 'column', 'Empresarial') }}
        {{ th(3, 'column', 'Natural') }}
    </tr>
{% endblock %}

{% block data %}
    <tr>
        {{ td(0, 'column', municipality.name) }}
        {{ td(1, 'column', municipality.province) }}
        {{ td(2, 'column', municipality.enterprise) }}
        {{ td(3, 'column', municipality.individual) }}
    </tr>
{% endblock %}
