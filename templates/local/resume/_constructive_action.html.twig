{% component 'Card:Card' with {
    cssClass: 'mb-4',
    extra: '',
    headerCssClass: 'd-flex justify-content-between align-items-center',
    title: 'Acciones constructivas de los locales del subsistema',
} %}
    {% block header %}
        {% from 'macros/buttons.html.twig' import tableActionButton2,tableActionButton3 %}
        <div>
            {{ tableActionButton3(path('app_sub_system_report_local_constructive_action', {'id':sub_system.id}), 'bi:printer', '', 'Imprimir', 'target="_blank"', 'btn-info') }}
        </div>
    {% endblock %}

    {% block body %}
        <table class="table table-hover">
            <tr>
                <th>Acción constructiva</th>
                <th>Cantidad</th>
                <th>Precio (CUP)</th>{# TODO: poner la moneda del proyecto #}
                <th>Metros(m<sup>2</sup>)</th>
            </tr>

            {% for key, value in constructive_action %}
                <tr>
                    <th>{{ key }}</th>
                    <th>{{ value['status'] }}</th>
                    <th>{{ money(value['price']) }}</th>
                    <th>{{ value['meter']|number_format(2) }}</th>
                </tr>
            {% endfor %}

            <tr>
                <th>Totales</th>
                <th>{{ sub_system.getLocalsAmount() }}</th>
                <th>{{ money(sub_system.getPrice(), null) }}</th>
                <th>{{ sub_system.getAmountMeters()|number_format(2) }}</th>
            </tr>
        </table>
    {% endblock %}

{% endcomponent %}
