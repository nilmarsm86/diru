{% component 'Card:Card' with {
    cssClass: 'mb-4',
    extra: '',
    headerCssClass: 'd-flex justify-content-between align-items-center',
    title: 'Listado de obras',
} %}
    {% block header %}
        {{ include('building/_header.html.twig', {'print_link':'app_building_project_print_list'}) }}
    {% endblock %}

    {% block body %}
        {% set columns = [null, 'Valor aprobado total', 'Valor estimado total', 'Existente', 'Estado', 'Constructora', 'Proyecto', 'Monto (CUP)'] %}

        {% component 'Table:Table' with {
            paginator: paginator,
            columns: columns
        } %}

            {% block tableHead %}
                <tr>
                    <th>Nombre</th>
                    <th data-bs-toggle="tooltip" data-bs-title="Valor aprobado total">V.A.T ({{ project.currency.code }}
                        )
                    </th>
                    <th data-bs-toggle="tooltip" data-bs-title="Valor estimado total">V.E.T ({{ project.currency.code }}
                        )
                    </th>
                    <th>Existente</th>
                    {% if app.request.query.get('state') == '' %}
                        <th>Estado {{ ux_icon('mdi:filter', {class:'bi'}) }}</th>
                    {% endif %}
                    <th>Constructora {{ ux_icon('bi:window-stack', {class:'bi'}) }}</th>
                    <th>Proyecto {{ ux_icon('bi:window-stack', {class:'bi'}) }}</th>
                    {#                    <th>Proyecto {{ ux_icon('bi:window-stack', {class:'bi'}) }}</th> #}
                    <th data-bs-toggle="tooltip" title="Costo de construcción">Monto</th>
                    <th></th>
                </tr>
            {% endblock %}

            {% block tableBody %}
                {% from 'macros/buttons.html.twig' import deleteFormButton, deleteFormButton2, tableActionButton3 %}

                {% for building in paginator.getData() %}
                    <tr {{ stimulusController('delete-form-container') }}>
                        <td>{{ building.name }}</td>
                        <td>{{ money(building.getTotalApprovedValue()) }}</td>
                        <td>{{ money(building.getTotalEstimatedValue()) }}</td>
                        <td>{{ building.isNew ? 'NO' : 'SI' }}</td>
                        {% if app.request.query.get('state') == '' %}
                            <td>
                                <a href="{{ path('app_building_project', {'project':project.id, 'state':building.state.value}) }}" {{ stimulusController('filter-link', {
                                    'queryName' : 'state',
                                    'data' : building.state.value
                                }) }}>
                                    {{ building.state.getLabelFrom(building.state) }}
                                </a>
                            </td>
                        {% endif %}
                        <td>
                            {% if building.hasActiveConstructorCorporateEntity() %}
                                <a href="#"
                                    {{ stimulusController('modal-content-loader', {
                                        url: path('app_corporate_entity_show', {'id':building.getActiveConstructorCorporateEntityId(), 'modal':'modal-load', 'state':'modal'}),
                                        id: 'modal-load',
                                        placeholder: 'Cargando...',
                                        title: 'Detalle de la constructora',
                                    }) }} {{ stimulusTarget('modal-content-loader', 'button') }}
                                >
                                    {{ building.getActiveConstructorCorporateEntityName() }}
                                </a>
                            {% else %}
                                <span class="text-danger">Sin constructora</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="#"
                                {{ stimulusController('modal-content-loader', {
                                    url: path('app_project_show', {'id':building.project.id, 'modal':'modal-load', 'state':'modal'}),
                                    id: 'modal-load',
                                    placeholder: 'Cargando...',
                                    title: 'Detalle del proyecto',
                                }) }} {{ stimulusTarget('modal-content-loader', 'button') }}
                            >
                                {{ building.project.name }}
                            </a>
                        </td>
                        <td>{{ money(building.getPrice(), building.project.currency.code) }}</td>
                        <td class="text-end">
                            {{ tableActionButton3(path('app_building_show', {'id': building.id}), 'bi:eye', '', 'Detalle de la obra', stimulusAction('twig/table/table', 'selectElement:prevent', null, {url:path('app_building_show', {'id': building.id})}), 'btn-link') }}
                            {{ tableActionButton3(path('app_building_edit', {'id': building.id, 'project': building.project.id}), 'fa:edit', '', 'Editar obra', '', 'btn-link') }}

                            {{ component('DeleteForm', {
                                path: path('app_building_delete', {'id': building.id}),
                                confirm: 'Está seguro que desea eliminar la obra?',
                                token: 'delete' ~ building.id,
                                title: 'Eliminar obra',
                                icon: 'bi:trash',
                                cssClass: 'btn-link text-danger'
                            }) }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8">No se encontraron obras.</td>
                    </tr>
                {% endfor %}
            {% endblock %}

        {% endcomponent %}

    {% endblock %}

{% endcomponent %}
