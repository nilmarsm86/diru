{% extends 'location_zone/pdf/pdf.html.twig' %}

{% block columns %}
    <tr>
        {{ th(0, 'column', 'Nombre') }}
        {{ th(1, 'column', 'Inversiones') }}
        {{ th(2, 'column', 'Proyectos') }}
        {{ th(3, 'column', 'Obras') }}
    </tr>
{% endblock %}

{% block data %}
    <tr>
        {{ td(0, 'column', location_zone.name) }}
        {{ td(1, 'column', location_zone.investments) }}
        {{ td(2, 'column', location_zone.projects) }}
        {{ td(3, 'column', location_zone.buildings) }}
    </tr>
{% endblock %}
