
<table>
    <tr>
        {{ th( 0, 'column', 'Nombre') }}
        {{ th(1, 'column', 'Valor aprobado total') }}
        {{ th(2, 'column', 'Valor estimado total') }}
        {{ th(3, 'column', 'Existente') }}
        {% if app.request.query.get('state') == '' %}
            {{ th(4, 'column', 'Estado') }}
        {% endif %}
        {{ th(5, 'column', 'Constructora') }}
        {{ th(6, 'column', 'Proyecto') }}
        {{ th(7, 'column', 'Monto (CUP)') }}
    </tr>
    {% for building in buildings %}
        <tr>
            {{ td(0, 'column', building.name) }}
            {{ td(1, 'column', building.getTotalApprovedValueFormated()) }}
            {{ td(2, 'column', building.getTotalEstimatedValueFormated()) }}
            {{ td(3, 'column', building.isNew ? 'NO' : 'SI') }}
            {% if app.request.query.get('state') == '' %}
                {{ td(4, 'column', building.state.getLabelFrom(building.state)) }}
            {% endif %}
            {{ td(5, 'column', building.hasActiveConstructorCorporateEntity() ? building.getActiveConstructorCorporateEntityName() : 'Sin constructora') }}
            {{ td(6, 'column', building.project.name) }}
            {{ td(7, 'column', money(building.getPrice())) }}
        </tr>
    {% else %}
        <tr>
            <td colspan="{{ colspan|default(8) }}">No se encontraron obras.</td>
        </tr>
    {% endfor %}
</table>
