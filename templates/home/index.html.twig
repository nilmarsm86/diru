{% extends 'content.html.twig' %}

{% from 'macros/breadcrumb.html.twig' import breadcrumb %}

{% block title %}Diru{% endblock %}

{% block content %}
    <div
        style="background-image: url({{ asset('images/dashboard1.jpg') }});min-height: 500px;padding: 10px;background-size: cover">

        <div class="row">
            {#            <h2>Section title</h2> #}
            <div class="col">
                {% component 'Card:Card' with {
                    cssClass: 'text-bg-light mb-3'
                } %}
                    {% block body %}
                        <h6 class="card-subtitle mb-2">Proyectos en el sistema</h6>
                        <h1>{{ project_amount }}</h1>
                        <a href="{{ path('app_project_index') }}" class="card-link">Ver todo</a>
                    {% endblock %}
                {% endcomponent %}
            </div>

            <div class="col pb-3">
                {% component 'Card:Card' with {
                    title: 'Proyectos',
                } %}
                    {% block body %}
                        <h6 class="card-subtitle mb-2">Monto total del sistema</h6>
                        <h1>{{ money(amount) }}</h1>
                    {% endblock %}
                {% endcomponent %}
            </div>

            <div class="col">
                {% component 'Card:Card' with {
                    title: 'Proyectos',
                } %}
                    {% block body %}
                        <h6 class="card-subtitle mb-2">Últimos Proyectos</h6>
                        <ul class="list-group list-group-flush">
                            {% for project in last_three %}
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <a href="{{ path('app_project_edit', {'id':project.id}) }}">{{ project.name }}</a>
                                    <span
                                        class="badge text-bg-primary rounded-pill">{{ money(project.getPrice()) }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endblock %}
                {% endcomponent %}
            </div>
        </div>
        <br>

        <div class="row">
            <div class="col-4">
                {% component 'Card:Card' with {
                    cssClass: 'text-bg-light mb-3'
                } %}
                    {% block body %}
                        <h6 class="card-subtitle mb-2">Regulaciones Urbanas utilizadas</h6>
                        <h1>{{ urban_regulations }}</h1>
                        <a href="{{ path('app_urban_regulation_index') }}" class="card-link">Ver todas</a>
                    {% endblock %}
                {% endcomponent %}
            </div>

            <div class="col-4">
                {% component 'Card:Card' with {
                    cssClass: 'text-bg-light mb-3'
                } %}
                    {% block body %}
                        <h6 class="card-subtitle mb-2">Subsistemas utilizados en el sistema</h6>
                        <h1>{{ subsystems }}</h1>
                        <a href="{{ path('app_historical_ite_subsystem') }}" class="card-link">Ver todas</a>
                    {% endblock %}
                {% endcomponent %}
            </div>
        </div>

        <div class="row">
            <div class="col-4">
                {% component 'Card:Card' with {
                    cssClass: 'text-bg-light mb-3'
                } %}
                    {% block body %}
                        <h6 class="card-subtitle mb-2">Obras en el sistema</h6>
                        <h1>{{ buildings }}</h1>
                        {#                        <a href="{{ path('app_urban_regulation_index') }}" class="card-link">Ver todas</a> #}
                    {% endblock %}
                {% endcomponent %}
            </div>
            <div class="col-4"></div>
            <div class="col-4">
                {% component 'Card:Card' with {
                    title: 'Finanzas',
                } %}
                    {% block body %}
                        <h6 class="card-subtitle mb-2">Finanzas de obras</h6>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                                <a>Valores aprobados</a>
                                <span
                                    class="badge text-bg-primary rounded-pill">{{ money(finance['approvedValue']) }}</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                                <a>Valores estimados</a>
                                <span
                                    class="badge text-bg-primary rounded-pill">{{ money(finance['estimatedValue']) }}</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                                <a>Presupuesto estimado</a>
                                <span
                                    class="badge text-bg-primary rounded-pill">{{ money(finance['estimatedAdjustValue']) }}</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                                <a>Presupuesto detallado</a>
                                <span
                                    class="badge text-bg-primary rounded-pill">{{ money(finance['constructionAssembly']) }}</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                                <a>valor real</a>
                                <span
                                    class="badge text-bg-primary rounded-pill">{{ money(finance['constructionRealValue']) }}</span>
                            </li>
                        </ul>
                    {% endblock %}
                {% endcomponent %}
            </div>
        </div>
    </div>
{% endblock %}
