{% from 'macros/buttons.html.twig' import tableActionButton3 %}

<div class="col d-grid gap-2 d-md-flex justify-content-md-end summary-btn-bar">
    <div class="dropdown d-inline-block">
        <button type="button"
                class="btn text-decoration-none btn-sm dropdown-toggle show dropdown-sm btn-info"
                data-bs-toggle="dropdown"
                aria-expanded="false" title="Obras del proyecto"
        >
            Reportes
        </button>
        <ul class="dropdown-menu" data-bs-theme="light">
            {% if building is not empty %}
                <li>
                    <a class="dropdown-item"
                       href="{{ path('app_building_report_local', {'id': building.id}) }}" title="">
                        Reporte de estado técnico por locales
                    </a>
                </li>
            {% endif %}
            <li>
                <a class="dropdown-item"
                   href="" title="">
                    Reporte de estado técnico por metros cuadrados
                </a>
            </li>
            <li>
                <hr class="dropdown-divider">
            </li>
            <li>
                <a class="dropdown-item"
                   href="" title="">
                    Reporte general de la obra (PDF)
                </a>
            </li>
        </ul>
    </div>

    {% if building.state is same as constant('App\\Entity\\Enums\\BuildingState::RevisionDraftsman') %}
        <div class="dropdown d-inline-block">
            <button type="button"
                    class="btn text-decoration-none btn-sm dropdown-toggle show dropdown-sm btn-primary"
                    data-bs-toggle="dropdown"
                    aria-expanded="false" title="Estados"
            >
                Estados
            </button>

            <ul class="dropdown-menu" data-bs-theme="light">
                <li>
                    <a class="dropdown-item"
                       href="{{ path('app_building_state_transition', {'id': building.id, 'type':'3'}) }}"
                       title="Pasar a estado de diseño">
                        Virar a diseño
                    </a>
                </li>
                <li>
                    <a class="dropdown-item"
                       href="{{ path('app_building_state_transition', {'id': building.id, 'type':'5'}) }}"
                       title="Pasar a estado de revisado">
                        Revisado
                    </a>
                </li>
            </ul>
        </div>
    {% endif %}

    {% set notRegisteredOrDiagnosis = [constant('App\\Entity\\Enums\\BuildingState::Registered'), constant('App\\Entity\\Enums\\BuildingState::Diagnosis')] %}
    {% if building.state not in notRegisteredOrDiagnosis %} {# TODO: pasar esta comprobacion para la entidad #}
        <div class="btn-group" role="group" aria-label="Revisiones">
            {% if building.hasBuildingRevisions() or building.state is same as constant('App\\Entity\\Enums\\BuildingState::RevisionDraftsman') %}
                <div class="dropdown d-inline-block">
                    <button type="button"
                            class="btn text-decoration-none btn-sm dropdown-toggle show dropdown-sm btn-primary"
                            data-bs-toggle="dropdown"
                            aria-expanded="false" title="Revisiones"
                    >
                        {{ ux_icon('bi:list', {'class':'bi'}) }}
                        Revisiones
                    </button>

                    <ul class="dropdown-menu" data-bs-theme="light">
                        <li>
                            <a class="dropdown-item" href="" title=""
                                {{ stimulusController('modal-content-loader', {
                                    url: path('app_building_revision_index', {'building': building.id, 'modal':'modal-load'}),
                                    id: 'modal-load',
                                    placeholder: 'Cargando...',
                                    title: (building.state is same as constant('App\\Entity\\Enums\\BuildingState::RevisionDraftsman')) ? 'Revisiones realizadas por el proyectista' : 'Revisiones realizadas',
                                }) }}
                                {{ stimulusTarget('modal-content-loader', 'button') }}
                            >
                                Listado
                            </a>
                        </li>
                        {% if building.state is same as constant('App\\Entity\\Enums\\BuildingState::RevisionDraftsman') %}
                            <li>
                                <a class="dropdown-item" href="" title=""
                                    {{ stimulusController('modal-content-loader', {
                                        url: path('app_building_revision_new', {'building': building.id, 'state':'modal', 'modal':'modal-load'}),
                                        id: 'modal-load',
                                        placeholder: 'Cargando...',
                                        title: 'Agregar revisión',
                                    }) }}
                                    {{ stimulusTarget('modal-content-loader', 'button') }}
                                >
                                    Agregar revisión
                                </a>
                            </li>
                        {% endif %}
                    </ul>

                </div>
            {% endif %}
        </div>
    {% endif %}

    {% if building.state is same as constant('App\\Entity\\Enums\\BuildingState::Design') and building.hasErrors() === false %}
        {{ tableActionButton3(path('app_building_state_transition', {'id': building.id, 'type': '4'}), 'material-symbols:rate-review', 'Revisar', 'Pasar a estado de revisión') }}
    {% endif %}

    {% if building.canReply() and building.hasErrors() == false %}
        {% set action_save = stimulusController('modal-content-loader', {
            url: path('app_building_state_more_floors', {'id':building.id, 'modal':'modal-load', 'state':'modal'}),
            id: 'modal-load',
            placeholder: 'Cargando...',
            title: 'Replicar obra',
        }) ~ stimulusTarget('modal-content-loader', 'button') %}
        {{ tableActionButton3(path('app_building_state_more_floors', {'id':building.id}), 'gis:copy-poly', 'Salvar', 'Crear inmueble a modificar', action_save) }}
    {% endif %}

    {% if building.isNew() is not null %}
        <div class="dropdown d-inline-block">
            <button type="button"
                    class="btn text-decoration-none btn-sm dropdown-toggle show dropdown-sm btn-primary"
                    data-bs-toggle="dropdown"
                    aria-expanded="false" title="Obras del proyecto"
            >
                {{ ux_icon('dinkie-icons:house-buildings-small', {'class':'bi'}) }}
                Inmueble
                {% if building.hasErrors() %}
                    <span
                        class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                    </span>
                {% endif %}
            </button>
            <ul class="dropdown-menu" data-bs-theme="light">
                <li>
                    <a class="dropdown-item"
                       href="{{ path('app_floor_index', {'building': building.id}) }}" title="">
                        {% if building.isNew() == false %}Existente{% else %}Nuevo{% endif %}
                    </a>
                </li>

                {% if building.hasReply() %}
                    <li>
                        <a class="dropdown-item"
                           href="{{ path('app_floor_index', {'building': building.id, 'reply': true}) }}" title="">
                            A modificar
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    {% endif %}

    {% if building.isNew() is not null and building.hasReply() === false %}
        <a class="btn btn-sm position-relative btn-primary" title="Resetear"
           data-bs-toggle="modal" data-bs-target="#confirm_reset">
            {{ ux_icon('ix:reset', {class:'bi'}) }}
            Resetear
        </a>
    {% endif %}

    {% if building.id is not null %}
        {% if building.land is null %}
            {% set urlPath = path('app_land_new', {'building': building.id, 'modal' : 'modal-load'}) %}
        {% else %}
            {% set urlPath = path('app_land_edit', {'building': building.id, 'modal' : 'modal-load', 'id':building.land.id}) %}
        {% endif %}

        <button class="btn btn-sm btn-primary"
                title="Datos generales del terreno"
            {{ stimulusTarget('modal-content-loader', 'button') }}
            {{ stimulusController('modal-content-loader', {
                url: urlPath,
                id: 'modal-load',
                placeholder: 'Cargando...',
                title: 'Datos generales del terreno',
            }) }}
        >
            {{ ux_icon('mdi:land-plots-marker', {'class':'bi'}) }}
            Datos generales del terreno
        </button>
    {% endif %}
    {% if building.project is not null %}
        {{ tableActionButton3(path('app_project_edit', {'id':building.project.id}), 'bi:table', 'Proyecto', 'Proyecto') }}
    {% endif %}
</div>
