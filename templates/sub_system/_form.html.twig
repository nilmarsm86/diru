{% component 'Card:Card' with {
    cssClass: 'mb-4',
    extra: '',
    headerCssClass: 'd-flex justify-content-between align-items-center',
    title: title
} %}

    {% block header %}
        {% if sub_system.id is not null %}
            &nbsp;
            <span class="badge bg-success">{{ sub_system.getTechnicalStatus() }}</span>
            <div class="col d-grid gap-2 d-md-flex justify-content-md-end summary-btn-bar"></div>
        {% endif %}

        {{ include('partials/_card_header_options.html.twig', {
            goTo: '',
            label: '',
            title: '',
            entity: sub_system,
            state: 'form',
            showButton: (showButton is defined and showButton == true) ? true : false
        }) }}
    {% endblock %}

    {% block body %}
        {{ component('SubSystemForm', {modal:null, ss: sub_system, ajax: ajax, floor:floor, 'reply':reply}) }}
    {% endblock %}

    {% block footer %}
        {{ include('partials/_card_footer.html.twig', {
            list: {},
            delete: {},
            id: floor.id,
            message: 'Está seguro que desea eliminar el subsistema?',
            state: 'form',
            showButton: (showButton is defined and showButton == true) ? true : false,
            entity: sub_system
        }) }}
    {% endblock %}

{% endcomponent %}

{{ include('partials/modal/_modal_load.html.twig') }}
