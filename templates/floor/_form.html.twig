{% component 'Card:Card' with {
    cssClass: 'mb-4',
    extra: '',
    headerCssClass: 'd-flex justify-content-between align-items-center',
    title: title
} %}

    {% block header %}
        {% if floor.id is not null %}
            &nbsp;
            <span class="badge bg-success">{{ floor.getTechnicalStatus() }}</span>
            <div class="col d-grid gap-2 d-md-flex justify-content-md-end summary-btn-bar"></div>
        {% endif %}

        {{ include('partials/_card_header_options.html.twig', {
            goTo: '',
            label: '',
            title: '',
            entity: floor,
            state: 'form',
            showButton: (showButton is defined and showButton == true) ? true : false
        }) }}
    {% endblock %}

    {% block body %}
        {{ component('FloorForm', {modal:null, fl: floor, ajax: ajax, building:building, 'reply':reply}) }}
    {% endblock %}

    {% block footer %}
        {{ include('partials/_card_footer.html.twig', {
            list: {},
            delete: {},
            id: floor.id,
            message: 'Está seguro que desea eliminar la planta?',
            state: 'form',
            showButton: (showButton is defined and showButton == true) ? true : false,
            entity: floor
        }) }}
    {% endblock %}

{% endcomponent %}
