{% extends 'pdf.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    <div>
        <strong>Proyectos:</strong>
        {% if filter %}
            <br>
            <strong>Filtrado por:</strong> {{ filter }}
        {% endif %}
    </div>
    <br>
    <table>
        {% block columns %}{% endblock %}
        {% for project in paginator.getData() %}
            {% block data %}{% endblock %}
        {% else %}
            <tr>
                <td colspan="{{ colspan|default(6) }}">No se encontraron projectos.</td>
            </tr>
        {% endfor %}
    </table>
{% endblock %}
