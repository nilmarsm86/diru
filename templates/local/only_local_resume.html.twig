{% extends 'content.html.twig' %}

{% from 'macros/breadcrumb.html.twig' import breadcrumb %}
{% from 'macros/titles.html.twig' import h1 %}

{% block title %}Resumen áreas útiles{% endblock %}

{% block content %}
    <div class="row">
        {{ h1('Resumen áreas útiles', 'lucide-lab:floor-plan') }}

        {{ breadcrumb([
            {label: 'Inicio', href: path('app_home')},
            {label: 'Locales y áreas', href: path('app_local_index', {'subSystem': sub_system.id, 'reply': reply}) },
            {label: 'Resumen áreas útiles'},
        ]) }}
    </div>

    <h5 class="mb-4">
        Datos de construcción:
    </h5>

    {{ include('structure/_structure_data.html.twig', {'structure' : sub_system}) }}

    {{ include('local/resume/_technical_status.html.twig', {'showButton': true, 'title': title, only_local: true}) }}
    {{ include('local/resume/_constructive_action.html.twig', {'showButton': true, 'title': title, only_local: true}) }}
{% endblock %}
