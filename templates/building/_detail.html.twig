{% component 'Card:Card' with {
    cssClass: 'mb-4',
    extra: 'id="building_detail_' ~ building.id~'"',
    headerCssClass: 'd-flex justify-content-between align-items-center',
    title: title,
} %}

    {% block header %}
        {% from 'macros/buttons.html.twig' import tableActionButton3 %}
{#        {{ include('building/_buttons_header.html.twig') }}#}
        {{ tableActionButton3('#', 'mdi:close', '', 'Cerrar', stimulusAction('twig/card/card', 'close:prevent'), 'btn-link') }}
    {% endblock %}

    {% block body %}
        <div class="table-responsive table mt-2" role="grid" aria-describedby="dataTable_info">
            <table class="table table-hover">
                <tbody>
                <tr>
                    <th>Nombre:</th>
                    <td>{{ building.name }}</td>
                </tr>
                <tr>
                    <th>Valor estimado de construcción:</th>
                    <td>{{ money(building.getPrice(), building.getProjectCurrency()) }}</td>
                </tr>
                <tr>
                    <th>Valor estimado de equipos:</th>
                    <td>{{ money(building.estimatedValueEquipment, building.getProjectCurrency()) }}</td>
                </tr>
                <tr>
                    <th>Otros valores estimados:</th>
                    <td>{{ money(building.estimatedValueOther, building.getProjectCurrency()) }}</td>
                </tr>
                <tr>
                    <th>Total valores estimados:</th>
                    <td>{{ money(building.getTotalEstimatedValue(), building.getProjectCurrency()) }}</td>
                </tr>
                <tr>
                    <th>Valor aprobado de construcción:</th>
                    <td>{{ money(building.approvedValueConstruction, building.getProjectCurrency()) }}</td>
                </tr>
                <tr>
                    <th>Valor aprobado de equipos:</th>
                    <td>{{ money(building.approvedValueEquipment, building.getProjectCurrency()) }}</td>
                </tr>
                <tr>
                    <th>Otros valores aprobados:</th>
                    <td>{{ money(building.approvedValueOther, building.getProjectCurrency()) }}</td>
                </tr>
                <tr>
                    <th>Total valores aprobados:</th>
                    <td>{{ money(building.getTotalApprovedValue(), building.getProjectCurrency()) }}</td>
                </tr>
                <tr>
                    <th>Entidad Constructora:</th>
                    <td>
                        {% if building.getActiveConstructorCorporateEntity() %}
                            <a href="#"
                                {{ stimulusController('modal-content-loader', {
                                    url: path('app_corporate_entity_show', {'id':building.getActiveConstructorCorporateEntityId(), 'modal':'modal-load', 'state':'modal'}),
                                    id: 'modal-load',
                                    placeholder: 'Cargando...',
                                    title: 'Constructora de la obra',
                                }) }} {{ stimulusTarget('modal-content-loader', 'button') }}
                            >
                                {{ building.getActiveConstructorCorporateEntityName() }} {{ ux_icon('bx:link-external', {class:'bi'}) }}
                            </a>
                        {% else%}
                            <span class="text-danger">Sin constructora</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Entidad Proyectista:</th>
                    <td>
                        {% if building.getActiveDraftmanCorporateEntity() %}
                            <a href="#"
                                {{ stimulusController('modal-content-loader', {
                                    url: path('app_corporate_entity_show', {'id':building.getActiveDraftmanCorporateEntityId(), 'modal':'modal-load', 'state':'modal'}),
                                    id: 'modal-load',
                                    placeholder: 'Cargando...',
                                    title: 'Proyectista de la obra',
                                }) }} {{ stimulusTarget('modal-content-loader', 'button') }}
                            >
                                {{ building.getActiveDraftmanCorporateEntityName() }} {{ ux_icon('bx:link-external', {class:'bi'}) }}
                            </a>
                        {% else%}
                            <span class="text-danger">Sin proyectista</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Proyecto:</th>
                    <td>
                        <a href="#"
                            {{ stimulusController('modal-content-loader', {
                                url: path('app_project_show', {'id':building.project.id, 'modal':'modal-load', 'state':'modal'}),
                                id: 'modal-load',
                                placeholder: 'Cargando...',
                                title: 'Proyecto al cual pertenece',
                            }) }} {{ stimulusTarget('modal-content-loader', 'button') }}
                        >
                            {{ building.project.name }} {{ ux_icon('bx:link-external', {class:'bi'}) }}
                        </a>
                    </td>
                </tr>
                <tr>
                    <th>Inversión:</th>
                    <td>
                        <a href="#"
                            {{ stimulusController('modal-content-loader', {
                                url: path('app_investment_show', {'id':building.project.investment.id, 'modal':'modal-load', 'state':'modal'}),
                                id: 'modal-load',
                                placeholder: 'Cargando...',
                                title: 'Inversión',
                            }) }} {{ stimulusTarget('modal-content-loader', 'button') }}
                        >
                            {{ building.project.investment.name }} {{ ux_icon('bx:link-external', {class:'bi'}) }}
                        </a>
                    </td>
                </tr>
                {# TODO: refactorizar #}
                <tr>
                    <th>Proyectistas:</th>
                    <td>
                        <ul class="px-0 list-unstyled">
                            {% for draftsman in building.getDraftsmans() %}
                                <li>
                                    <a href="#"
                                        {{ stimulusController('modal-content-loader', {
                                            url: path('app_person_show', {'id':draftsman.id, 'modal':'modal-load', 'state':'modal'}),
                                            id: 'modal-load',
                                            placeholder: 'Cargando...',
                                            title: 'Proyectista',
                                        }) }} {{ stimulusTarget('modal-content-loader', 'button') }}
                                    >
                                        {{ draftsman.name }} {{ ux_icon('bx:link-external', {class:'bi'}) }}
                                    </a>
                                </li>
                            {% else %}
                                <li class="text-danger">No tiene proyectistas asociados.</li>
                            {% endfor %}
                        </ul>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    {% endblock %}

    {% block footer %}
        {{ include('partials/_card_footer.html.twig', {
            list: {href: 'app_project_index', label: 'Proyectos', title:'listado de proyectos'},
            edit: {href: 'app_building_edit', label: 'Editar', title:'Editar obra'},
            delete: null,
            id: building.id,
            message: 'Está seguro que desea eliminar la obra?',
            state: 'detail',
            showButton: (showButton is defined and showButton == true) ? true : false
        }) }}
    {% endblock %}

{% endcomponent %}

{#{{ include('partials/modal/_modal_load.html.twig') }}#}


