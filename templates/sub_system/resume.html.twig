{% extends 'content.html.twig' %}

{% from 'macros/breadcrumb.html.twig' import breadcrumb %}
{% from 'macros/titles.html.twig' import h1 %}

{% block title %}Resumen de los subsistemas{% endblock %}

{% block content %}
    <div class="row">
        {{ h1('Resumen de los subsistemas', 'ix:building-block-filled') }}

        {{ breadcrumb([
            {label: 'Inicio', href: path('app_home')},
            {label: 'Subsistemas', href: path('app_sub_system_index', {'floor':floor.id, 'reply': reply})},
            {label: 'Resumen'},
        ]) }}
    </div>

    <div class="row mb-3">
        <div class="col">
            {{ include('structure/_structure_data.html.twig', {'structure' : floor}) }}
        </div>
        <div class="col">
            {{ include('structure/_resume_data.html.twig', {'structure' : floor}) }}
        </div>
    </div>

    {{ include('sub_system/resume/_classification.html.twig', {'showButton': true, 'title': title}) }}
{% endblock %}
