{% component 'Card:Card' with {
    cssClass: 'mb-4',
    extra: '',
    headerCssClass: 'd-flex justify-content-between align-items-center',
    title: title,
} %}
    {% block header %}
        <div>
            {{ component('Card:Refresh', {
                path: path('app_municipality_amount_project_report'),
                queryNames:['column', 'amount', 'filter', 'page']
            }) }}

            {{ include('municipality/report/_header.html.twig', {'print_link':'app_municipality_amount_project_report_print'}) }}
        </div>
    {% endblock %}

    {% block body %}
        {% component 'Table:Table' with {
            paginator: paginator,
        } %}

            {% block tableHead %}
                <tr>
                    <th>Nombre</th>
                    <th>Provincia {{ ux_icon('mdi:filter', {class:'bi'}) }}</th>
                    <th>Proyectos {{ ux_icon('fa:check-square-o', {class:'bi'}) }}</th>
                    <th>Obras {{ ux_icon('fa:check-square-o', {class:'bi'}) }}</th>
                </tr>
            {% endblock %}

            {% block tableBody %}
                {% from 'macros/link.html.twig' import filterLink %}

                {% for municipality in paginator.getData() %}
                    <tr>
                        <td>{{ municipality.name }}</td>
                        <td>
                            <a href="{{ filterLink(municipality.province) }}"
                               class="text-decoration-none"
                            >
                                {{ municipality.province }}
                            </a>
                        </td>
                        <td>{{ municipality.projects }}</td>
                        <td>{{ municipality.buildings }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">No se encontraron municipios.</td>
                    </tr>
                {% endfor %}
            {% endblock %}

        {% endcomponent %}

    {% endblock %}

{% endcomponent %}
